$C = "Common.ui";

Group #LightingColorPicker {
  LayoutMode: Left;
  Anchor: (Bottom: 16);

  Label #LightingColorPickerLabel {
    Style: (FontSize: 32, Alignment: Center);
    Anchor: (Top: 50);
    Text: "Select Light Color";
    Padding: (Full: 10);
  }

  ColorPickerDropdownBox #LightingColorPickerValue {
    Anchor: (Width: 50, Height: 32, Left: 0, Right: 16);
    Format: Rgb;
    Style: $C.@DefaultColorPickerDropdownBoxStyle;
    DisplayTextField: true;
  }
}